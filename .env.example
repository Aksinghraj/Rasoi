# Rasoi environment variables
#
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored; never commit real credentials.
#
# Supabase is OPTIONAL. Both values must be present for cloud accounts and
# cross-device sync. Leave them blank to run in labelled device-only mode.
#
# Public client configuration only. The anon key is safe to ship because
# Row Level Security enforces access. NEVER put the service-role key in this
# file or anywhere in the Expo app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public HTTPS origin of the web app, used only when the web build itself is
# opened on localhost (a link emailed to a phone must not point at the phone).
# Set this to the current Ideavo preview origin, without a trailing slash, and
# add `<origin>/auth/callback` to Supabase Authentication -> URL Configuration
# -> Redirect URLs. A deployed web origin always wins over this value.
EXPO_PUBLIC_APP_URL=

# Optional native-only override for the email confirmation redirect. Leave this
# blank for production Android builds: they use the `rasoi://auth/callback`
# deep link. Set it only when a development build must come back through an
# HTTPS preview, for example `https://<preview-host>/auth/callback`.
# This is deliberately separate from EXPO_PUBLIC_APP_URL so a temporary web
# preview can never leak into the production native deep link.
EXPO_PUBLIC_NATIVE_AUTH_REDIRECT_URL=

# Server-side only (do not add these to the Expo app):
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RETAILER_CLIENT_ID=
# RETAILER_CLIENT_SECRET=
