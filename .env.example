# Rasoi environment variables
#
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored; never commit real credentials.
#
# Supabase is OPTIONAL. Both values must be present for cloud accounts and
# cross-device sync. Leave them blank to run in labelled device-only mode.
#
# Public client configuration only. The anon key is safe to ship because
# Row Level Security enforces access. NEVER put the service-role key in this
# file or anywhere in the Expo app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public HTTPS URL of the running app, used only to send email confirmation
# links somewhere reachable (for example the current preview host). The web
# build derives its own origin and ignores this. Leave blank for production
# native builds so confirmation links use the `rasoi://` app scheme instead.
EXPO_PUBLIC_APP_URL=

# Server-side only (do not add these to the Expo app):
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RETAILER_CLIENT_ID=
# RETAILER_CLIENT_SECRET=
